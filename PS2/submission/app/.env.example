DATAMALL_ACCOUNT_KEY=

# Optional — map tiles. Left blank, the app uses Stadia Maps, which
# auto-authenticates localhost (so `npm run dev` needs no key). For a deployed
# demo, either whitelist your domain free in the Stadia dashboard, or set these
# to a keyed provider (e.g. MapTiler). Never commit a secret key; a
# domain-restricted map URL is fine here because it is NEXT_PUBLIC (client-side).
NEXT_PUBLIC_TILE_URL=
NEXT_PUBLIC_TILE_ATTRIBUTION=

# Optional: free at aistudio.google.com. Without it, the app falls back to
# the 2-value Status-keyed heuristic for notices with no stated duration —
# see src/lib/advice.ts and src/lib/engine.ts.
GEMINI_API_KEY=
# Optional override — defaults to gemini-3.5-flash-lite (verified against
# ai.google.dev/api/generate-content). Model names in this space go stale
# fast; if calls start failing, check the current free-tier model name and
# set it here rather than editing code. Note: free-tier quota is per-model
# and per-DAY (not per-minute) — a 429 on one model doesn't mean the key is
# dead, just that that specific model's daily cap is hit; try a different
# model here rather than waiting.
GEMINI_MODEL=

# Optional locally, required in production (Vercel): free at upstash.com.
# Without these, the app falls back to an in-memory cache that only works
# correctly on a single long-running process (fine for `next dev`, NOT
# correct once deployed to Vercel's serverless functions — see
# src/lib/store.ts for why).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
